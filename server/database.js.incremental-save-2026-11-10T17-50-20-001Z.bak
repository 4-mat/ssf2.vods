const { Pool } = require("pg");

const pool = new Pool({
    connectionString: process.env.DATABASE_URL,
    ssl: process.env.DATABASE_URL ? { rejectUnauthorized: false } : undefined
});

async function initialize(initialData) {
    // Keep the original TSV row as a one-time backup. Never overwrite it.
    await pool.query(`
        CREATE TABLE IF NOT EXISTS app_data (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL
        )
    `);

    await pool.query(
        `INSERT INTO app_data (key, value)
         VALUES ($1, $2)
         ON CONFLICT (key) DO NOTHING`,
        ["match_data", initialData]
    );

    const result = await pool.query(
        "SELECT COUNT(*)::INTEGER AS count FROM public.videos"
    );

    if(result.rows[0].count === 0) {
        throw new Error(
            "The normalized videos table is empty. Refusing to start without migrated video data."
        );
    }
}

async function loadMatchData() {
    const [videosResult, tagsResult, matchesResult] = await Promise.all([
        pool.query(`
            SELECT youtube_id, video_date, netplay, provisional_ip, netcode
            FROM public.videos
            ORDER BY source_order
        `),
        pool.query(`
            SELECT video_id, position, tag
            FROM public.video_tags
            ORDER BY video_id, position
        `),
        pool.query(`
            SELECT video_id, timestamp_seconds, p1_character, p1_name,
                   p2_character, p2_name, winner
            FROM public.matches
            ORDER BY video_id, timestamp_seconds, id
        `)
    ]);

    return {
        videos: videosResult.rows,
        tags: tagsResult.rows,
        matches: matchesResult.rows
    };
}

async function saveMatchData(data) {
    if(!data || typeof data !== "object" || Array.isArray(data) || Object.keys(data).length === 0) {
        throw new Error("Refusing to save an empty or invalid video collection.");
    }

    const videos = Object.entries(data);
    const videoIds = [];
    const videoDates = [];
    const netplays = [];
    const provisionalIps = [];
    const netcodes = [];
    const sourceOrders = [];

    const tagVideoIds = [];
    const tagPositions = [];
    const tagValues = [];

    const matchVideoIds = [];
    const matchTimes = [];
    const p1Characters = [];
    const p1Names = [];
    const p2Characters = [];
    const p2Names = [];
    const winners = [];

    videos.forEach(([videoId, video], videoIndex) => {
        videoIds.push(videoId);
        videoDates.push(video.date);
        netplays.push(video.netplay);
        provisionalIps.push(video.provIP || null);
        netcodes.push(video.netcode || "");
        sourceOrders.push(videoIndex + 1);

        (video.tags || []).forEach((tag, tagIndex) => {
            tagVideoIds.push(videoId);
            tagPositions.push(tagIndex + 1);
            tagValues.push(String(tag).trim());
        });

        (video.matches || []).forEach(match => {
            matchVideoIds.push(videoId);
            matchTimes.push(parseInt(match.time, 10));
            p1Characters.push(match.p1char);
            p1Names.push(match.p1name);
            p2Characters.push(match.p2char);
            p2Names.push(match.p2name);
            winners.push(parseInt(match.winner, 10));
        });
    });

    const client = await pool.connect();

    try {
        await client.query("BEGIN");

        // Delete child rows first to satisfy the foreign keys.
        await client.query("DELETE FROM public.matches");
        await client.query("DELETE FROM public.video_tags");
        await client.query("DELETE FROM public.videos");

        await client.query(`
            INSERT INTO public.videos
                (youtube_id, video_date, netplay, provisional_ip, netcode, source_order)
            SELECT *
            FROM unnest(
                $1::text[], $2::date[], $3::text[], $4::text[], $5::text[], $6::integer[]
            )
        `, [videoIds, videoDates, netplays, provisionalIps, netcodes, sourceOrders]);

        await client.query(`
            INSERT INTO public.video_tags (video_id, position, tag)
            SELECT *
            FROM unnest($1::text[], $2::integer[], $3::text[])
        `, [tagVideoIds, tagPositions, tagValues]);

        await client.query(`
            INSERT INTO public.matches
                (video_id, timestamp_seconds, p1_character, p1_name,
                 p2_character, p2_name, winner)
            SELECT *
            FROM unnest(
                $1::text[], $2::integer[], $3::text[], $4::text[],
                $5::text[], $6::text[], $7::smallint[]
            )
        `, [
            matchVideoIds, matchTimes, p1Characters, p1Names,
            p2Characters, p2Names, winners
        ]);

        await client.query("COMMIT");
    } catch(error) {
        await client.query("ROLLBACK");
        throw error;
    } finally {
        client.release();
    }
}

module.exports = { initialize, loadMatchData, saveMatchData };
